@model nurkybek.Models.ContactFormModel
<section class="section-shell section-pad contact-section" id="contact">
  <div class="section-heading"><p class="eyebrow">14 / Let's connect</p><h2>Let's build something<br /><span class="muted-heading">together.</span></h2><p class="section-lede">I am always interested in learning, collaborating and building meaningful software projects.</p></div>
  <div class="contact-layout"><div class="contact-details"><div class="contact-item"><span class="contact-icon"><i class="bi bi-envelope"></i></span><span><small>EMAIL</small><strong>Email address not provided</strong><em>Add a real email address to enable direct contact</em></span><i class="bi bi-arrow-up-right contact-arrow" aria-hidden="true"></i></div><a class="contact-item" href="https://github.com/Nurlybek2006" target="_blank" rel="noopener noreferrer"><span class="contact-icon"><i class="bi bi-github"></i></span><span><small>GITHUB</small><strong>github.com/Nurlybek2006</strong><em>Repositories &amp; current work</em></span><i class="bi bi-arrow-up-right contact-arrow" aria-hidden="true"></i></a><a class="contact-item" href="https://www.linkedin.com/in/nurlybek-sarsenbekuly-114a27251/" target="_blank" rel="noopener noreferrer"><span class="contact-icon"><i class="bi bi-linkedin"></i></span><span><small>LINKEDIN</small><strong>Nurlybek Sarsenbekuly</strong><em>Connect professionally</em></span><i class="bi bi-arrow-up-right contact-arrow" aria-hidden="true"></i></a><div class="availability"><span class="status-dot"></span><span>Open to learning, collaboration<br /><small>Almaty, Kazakhstan · UTC+5</small></span></div></div>
    <form class="contact-form" asp-controller="Home" asp-action="Contact" method="post" novalidate>@Html.AntiForgeryToken()<div class="form-intro"><span>WRITE A MESSAGE</span><i class="bi bi-arrow-down-right"></i></div><div class="form-row"><label asp-for="Name">Your name</label><input asp-for="Name" placeholder="How should I call you?" autocomplete="name" /><span asp-validation-for="Name" class="field-error"></span></div><div class="form-row"><label asp-for="Email">Email address</label><input asp-for="Email" placeholder="you@example.com" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div><div class="form-row"><label asp-for="Message">Message</label><textarea asp-for="Message" rows="4" placeholder="Tell me a little about it..."></textarea><span asp-validation-for="Message" class="field-error"></span></div><div class="form-submit"><button class="button button-primary" type="submit">Send message <i class="bi bi-arrow-up-right"></i></button><span>Delivery requires email service setup.</span></div>@if (TempData["ContactNotice"] is string notice) { <p class="contact-notice" role="status">@notice</p> }</form>
  </div>
</section>
