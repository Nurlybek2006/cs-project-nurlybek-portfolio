@model nurkybek.Models.ContactFormModel
<section class="section-shell section-pad contact-section" id="contact">
  <div class="section-heading"><p class="eyebrow">06 / Let’s connect</p><h2>Have an idea?<br /><span class="muted-heading">Let’s talk about it.</span></h2><p class="section-lede">I’m always interested in thoughtful projects, good questions and new things to learn.</p></div>
  <div class="contact-layout"><div class="contact-details"><div class="contact-item"><span class="contact-icon"><i class="bi bi-envelope"></i></span><span><small>EMAIL</small><strong>your.email@example.com</strong><em>Replace with your address</em></span><i class="bi bi-arrow-up-right contact-arrow" aria-hidden="true"></i></div><div class="contact-item"><span class="contact-icon"><i class="bi bi-github"></i></span><span><small>GITHUB</small><strong>Profile link not set</strong><em>Add your GitHub URL</em></span><i class="bi bi-arrow-up-right contact-arrow" aria-hidden="true"></i></div><div class="contact-item"><span class="contact-icon"><i class="bi bi-linkedin"></i></span><span><small>LINKEDIN</small><strong>Profile link not set</strong><em>Add your LinkedIn URL</em></span><i class="bi bi-arrow-up-right contact-arrow" aria-hidden="true"></i></div><div class="availability"><span class="status-dot"></span><span>Open to learning, collaboration<br /><small>Almaty, Kazakhstan · UTC+5</small></span></div></div>
    <form class="contact-form" asp-controller="Home" asp-action="Contact" method="post" novalidate>@Html.AntiForgeryToken()<div class="form-intro"><span>WRITE A MESSAGE</span><i class="bi bi-arrow-down-right"></i></div><div class="form-row"><label asp-for="Name">Your name</label><input asp-for="Name" placeholder="How should I call you?" autocomplete="name" /><span asp-validation-for="Name" class="field-error"></span></div><div class="form-row"><label asp-for="Email">Email address</label><input asp-for="Email" placeholder="you@example.com" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span></div><div class="form-row"><label asp-for="Message">Message</label><textarea asp-for="Message" rows="4" placeholder="Tell me a little about it..."></textarea><span asp-validation-for="Message" class="field-error"></span></div><div class="form-submit"><button class="button button-primary" type="submit">Send message <i class="bi bi-arrow-up-right"></i></button><span>Delivery requires email service setup.</span></div>@if (TempData["ContactNotice"] is string notice) { <p class="contact-notice" role="status">@notice</p> }</form>
  </div>
</section>
