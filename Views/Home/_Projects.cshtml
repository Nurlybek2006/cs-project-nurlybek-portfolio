@model IReadOnlyList<nurkybek.Models.ProjectItem>
<section class="section-shell section-pad" id="projects">
  <div class="section-heading heading-row"><div><p class="eyebrow">09 / Project archive</p><h2>More things<br /><span class="muted-heading">I’m building.</span></h2></div><p class="heading-note">A selection of backend and fullstack work. Open each public repository to explore its code and README.</p></div>
  <div class="project-grid">
  @foreach (var project in Model)
  {
    <article class="project-card reveal-on-scroll"><div class="project-top"><span class="project-number">@project.Category.ToUpperInvariant() / @project.Number</span><span class="project-mark"><i class="bi bi-arrow-up-right"></i></span></div><div class="project-art art-@project.Number"><span class="art-ring"></span><i class="bi @(project.Number == "01" ? "bi-boxes" : project.Number == "02" ? "bi-kanban" : "bi-bag-check")"></i><span class="art-caption">SYSTEM / @project.Number</span></div><h3>@project.Name</h3><p>@project.Description</p><div class="project-tags">@foreach (var tech in project.Technologies) { <span>@tech</span> }</div><div class="project-links"><a class="project-github" href="@project.GithubUrl" target="_blank" rel="noopener noreferrer"><i class="bi bi-github"></i> View on GitHub <i class="bi bi-arrow-up-right"></i></a>@if (!string.IsNullOrWhiteSpace(project.DemoUrl)) { <a class="project-demo" href="@project.DemoUrl" target="_blank" rel="noopener noreferrer"><i class="bi bi-box-arrow-up-right"></i> Live demo</a> }</div></article>
  }
  </div>
</section>
