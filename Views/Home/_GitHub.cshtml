@model nurkybek.Models.HomeViewModel
<section class="section-shell section-pad github-section" id="github">
  <div class="github-panel"><div class="github-copy"><p class="eyebrow">13 / Open source &amp; activity</p><h2>My work lives<br /><span class="muted-heading">in public.</span></h2><p>Follow along as I learn, build and share projects on GitHub. Visit my profile for repositories, pinned work and current experiments.</p><a class="button button-primary" href="@Model.GitHubUrl" target="_blank" rel="noopener noreferrer">Explore GitHub profile <i class="bi bi-arrow-up-right"></i></a><a class="github-linkedin" href="@Model.LinkedInUrl" target="_blank" rel="noopener noreferrer"><i class="bi bi-linkedin"></i> Find me on LinkedIn <i class="bi bi-arrow-up-right"></i></a></div><div class="github-visual"><div class="github-visual-head"><span><i class="bi bi-github"></i> @Model.GitHubUrl.Replace("https://github.com/", "")</span><span class="github-visual-badge"><i class="bi bi-circle-fill"></i> LEARNING IN PUBLIC</span></div><div class="github-grid-wrap"><div class="github-months"><span>Jan</span><span>Feb</span><span>Mar</span><span>Apr</span><span>May</span><span>Jun</span><span>Jul</span><span>Aug</span><span>Sep</span><span>Oct</span><span>Nov</span><span>Dec</span></div><div class="github-grid" aria-label="Illustrative GitHub-style activity grid">@for (var i = 0; i < 364; i++) { var level = ((i * 17 + i / 7 * 5 + 11) % 13); <span class="activity-cell level-@(level == 0 ? 0 : level < 4 ? 1 : level < 8 ? 2 : level < 11 ? 3 : 4)" aria-hidden="true"></span> }</div></div><div class="github-grid-foot"><span>Less</span><i class="activity-cell level-0"></i><i class="activity-cell level-1"></i><i class="activity-cell level-2"></i><i class="activity-cell level-3"></i><i class="activity-cell level-4"></i><span>More</span></div><p class="github-disclaimer">Illustrative activity visualization — not live contribution data.</p></div></div>
</section>
