@model nurkybek.Models.ProjectItem
<section class="section-shell featured-section" aria-labelledby="featured-title">
  <div class="featured-intro"><p class="eyebrow">08 / Featured project</p><h2 id="featured-title">Explore an idea<br /><span class="muted-heading">from the inside out.</span></h2><p>Project work is where architecture, data and practical product decisions come together.</p><a class="text-link" href="#projects">Browse all projects <i class="bi bi-arrow-down-right"></i></a></div>
  <article class="featured-card"><div class="featured-visual"><div class="featured-orbit orbit-a"></div><div class="featured-orbit orbit-b"></div><span class="featured-node node-block"><i class="bi bi-box-seam"></i><small>BLOCKS</small></span><span class="featured-node node-index"><i class="bi bi-lightning-charge"></i><small>INDEXER</small></span><span class="featured-node node-store"><i class="bi bi-database"></i><small>DATA</small></span><span class="featured-connect connect-one"></span><span class="featured-connect connect-two"></span><span class="featured-center"><i class="bi bi-hdd-network"></i></span><span class="featured-caption">EVENT → INDEX → QUERY</span></div><div class="featured-content"><div class="project-top"><span class="project-number">FEATURED / @Model.Number · @Model.Category</span><span class="project-mark"><i class="bi bi-arrow-up-right"></i></span></div><h3>@Model.Name</h3><p>@Model.Description</p><div class="project-tags">@foreach (var tech in Model.Technologies) { <span>@tech</span> }</div><a class="button button-quiet featured-link" href="@Model.GithubUrl" target="_blank" rel="noopener noreferrer">View project on GitHub <i class="bi bi-arrow-up-right"></i></a></div></article>
</section>
